<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:text="TWIN✦STAR S"
            android:textColor="#FFE6E6E6"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFB69CFF"
            android:textSize="20sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_n1" style="@style/WidgetRow" />
    <TextView android:id="@+id/w_n2" style="@style/WidgetRow" />
    <TextView android:id="@+id/w_n3" style="@style/WidgetRow" />
    <TextView android:id="@+id/w_n4" style="@style/WidgetRow" />
</LinearLayout>
